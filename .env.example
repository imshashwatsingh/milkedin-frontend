# milkedIn frontend configuration
# Copy this file to `.env` and adjust values as needed.

# Base URL of the milk_logs_backend API.
#
# Required for standalone/production builds.
# In development, if this is left unset the app tries to reach the backend
# at http://<dev-machine-ip>:4000 using the Expo dev server host,
# falling back to http://localhost:4000.
EXPO_PUBLIC_API_URL=http://192.168.1.100:4000